# Telegram Bot Configuration
# Get BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Run `python main.py --get-chat-id` to auto-detect your CHAT_ID, or use @getmyid_bot
TELEGRAM_CHAT_ID=your_chat_id_here

# UM SPeCTRUM Base URL (usually https://spectrum.um.edu.my)
SPECTRUM_BASE_URL=https://spectrum.um.edu.my

# Check Interval in minutes (default: 30 minutes)
CHECK_INTERVAL_MINUTES=30

# Optional: Comma-separated list of Course IDs or keywords to monitor.
# Leave empty to automatically monitor ALL enrolled courses found on your dashboard.
# Example: WIX1002,WIX2001
MONITORED_COURSES=

# Comma-separated list of keywords/portal names to exclude from monitoring
EXCLUDED_COURSES=LEAP,Turnitin

# Optional: SiswaMail address (e.g. s21xxxxx@siswa.um.edu.my) for passwordless QR code login via Telegram
SISWA_EMAIL=
